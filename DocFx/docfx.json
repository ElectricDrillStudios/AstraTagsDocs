{
  "metadata": [
    {
      "src": [],
      "globalNamespaceId": "Global",
      "filter": "filterConfig.yml",
      "dest": "api",
      "allowCompilationErrors": false,
      "properties": {
        "ProduceReferenceAssembly": "true"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml"], "exclude": ["_site/**", ".astra-workspace/**", "README.md", "CLAUDE.md", "AGENTS.md", "context/**", "release-lock.yml"] },
      { "src": "DocFx/MD", "dest": "MD", "files": ["**/*.{md,yml}"] },
      { "files": ["api/**/*.{md,yml}"] }
    ],
    "resource": [
      { "src": "DocFx/images", "dest": "images", "files": ["**/*"] }
    ],
    "output": "_site",
    "template": ["default", "modern", "DocFx/templates/astra"],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "Astra Tags",
      "_appTitle": "Astra Tags",
      "_appLogoPath": "images/astra-logo.svg",
      "_enableSearch": true,
      "_enableBreadcrumb": true,
      "_disableContribution": true,
      "_baseUrl": "https://electricdrillstudios.github.io/AstraTagsDocs/"
    },
    "xref": []
  }
}
