{
  "metadata": [
    {
      "src": [
        {
          "src": "../AstraPublishing_6_3_8_2D",
          "files": ["com.electricdrill.astra-tags.Runtime.csproj"],
          "exclude": ["Editor/**", "bin/**"]
        }
      ],
      "globalNamespaceId": "Global",
      "filter": "DocFx/filterConfig.yml",
      "dest": "api",
      "allowCompilationErrors": true,
      "properties": {
        "ProduceReferenceAssembly": "true"
      }
    }
  ],
  "build": {
    "content": [
      { "files": ["index.md", "toc.yml"] },
      { "src": "DocFx/MD", "dest": "MD", "files": ["**/*.{md,yml}"] },
      { "files": ["api/**/*.{md,yml}"] }
    ],
    "resource": [
      { "src": "DocFx/images", "dest": "images", "files": ["**/*"] }
    ],
    "output": "docs",
    "template": ["default", "modern", "DocFx/templates/astra"],
    "disableGitFeatures": true,
    "globalMetadata": {
      "_appName": "Astra Tags",
      "_appTitle": "Astra Tags",
      "_appLogoPath": "images/astra-logo.svg",
      "_enableSearch": true,
      "_enableBreadcrumb": true,
      "_disableContribution": true,
      "_baseUrl": "https://electricdrillstudios.github.io/AstraTagsDocs/"
    },
    "xref": ["https://normanderwan.github.io/UnityXrefMaps/xrefmap.yml"]
  }
}
